{
  "id": "gluniverse-daggerheart",
  "title": "GLUniverse — Daggerheart",
  "description": "An unofficial Foundry VTT game system for Daggerheart: duality dice, Hope and Fear, domain card loadouts, and a sheet built for the table rather than the rulebook.",
  "version": "1.12.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "patcharapon-j"
    }
  ],
  "esmodules": [
    "module/daggerheart.js"
  ],
